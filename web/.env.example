# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/signalai"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1-mini"

# Beehiiv newsletter
BEEHIIV_API_KEY="bh-..."
BEEHIIV_PUBLICATION_ID="pub_..."

# Cron security (set a long random string, same value in Vercel env)
CRON_SECRET="your-cron-secret-here"

# Admin API (optional — omit to allow all in dev)
ADMIN_API_KEY="your-admin-key-here"
