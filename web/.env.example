# ─── Required ────────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string (get from Supabase project settings)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# OpenAI API key — required in production for article analysis, embeddings, trend generation
OPENAI_API_KEY="sk-..."

# Beehiiv newsletter delivery
BEEHIIV_API_KEY="bh-..."
BEEHIIV_PUBLICATION_ID="pub_..."

# ─── Cron & Admin Security ────────────────────────────────────────────────────

# Long random string — set the same value in Vercel env vars.
# Vercel passes this as `Authorization: Bearer <secret>` on cron requests.
# If omitted, cron and admin endpoints are unprotected (fine for local dev).
CRON_SECRET="your-long-random-secret-here"

# Optional API key to restrict /api/admin/* endpoints
ADMIN_API_KEY="your-admin-key-here"

# ─── Optional (have sane defaults) ──────────────────────────────────────────

# OpenAI model for article analysis and trend generation (default: gpt-4.1-mini)
OPENAI_MODEL="gpt-4.1-mini"

# OpenAI model for text embeddings (default: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# GitHub personal access token — avoids rate limits on GitHub source handler
# Without this, GitHub ingestion may hit 60 req/hr anonymous limit
GITHUB_TOKEN="ghp_..."

# Comma-separated RSS feed URLs to add to ingestion beyond the built-in registry
# Example: RSS_FEEDS="https://example.com/feed,https://other.com/rss"
RSS_FEEDS=""
